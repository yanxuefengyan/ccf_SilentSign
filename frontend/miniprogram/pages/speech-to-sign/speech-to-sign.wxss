/* speech-to-sign.wxss - 语音转手语页面样式 */
.container {
  padding: 20rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #666;
}

/* 动画显示区域 */
.animation-container {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.sign-animation {
  width: 100%;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f9f9f9;
  border-radius: 15rpx;
  position: relative;
}

.animation-placeholder {
  text-align: center;
}

.placeholder-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: block;
}

.emotion-indicator {
  font-size: 60rpx;
  transition: all 0.3s ease;
}

/* 录音控制区域 */
.recording-control {
  text-align: center;
  margin-bottom: 40rpx;
}

.record-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  background-color: #07C160;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  padding: 0;
  box-shadow: 0 5rpx 15rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s ease;
}

.record-btn.recording {
  background-color: #FA5151;
  box-shadow: 0 5rpx 15rpx rgba(250, 81, 81, 0.3);
}

.record-btn:hover {
  transform: scale(1.05);
}

.recording-status {
  margin-top: 30rpx;
}

.status-text {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}

.recording-wave {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 50rpx;
  gap: 8rpx;
}

.wave-bar {
  width: 12rpx;
  height: 100%;
  background-color: #07C160;
  border-radius: 6rpx;
  animation: waveAnimation 1s infinite ease-in-out;
}

.wave-bar.delay-1 {
  animation-delay: 0.2s;
}

.wave-bar.delay-2 {
  animation-delay: 0.4s;
}

@keyframes waveAnimation {
  0%, 100% { height: 20%; }
  50% { height: 100%; }
}

/* 识别结果 */
.result-panel {
  background: white;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.result-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  display: block;
}

.result-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
}

/* 常用短语 */
.phrases-panel {
  background: white;
  border-radius: 20rpx;
  padding: 25rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.phrases-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.phrases-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.phrase-btn {
  background-color: #f0f2f5;
  border-radius: 15rpx;
  padding: 15rpx 20rpx;
  font-size: 24rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 250rpx;
}

.phrase-btn:hover {
  background-color: #e5e7eb;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .title {
    font-size: 32rpx;
  }
  
  .subtitle {
    font-size: 22rpx;
  }
  
  .record-btn {
    width: 180rpx;
    height: 180rpx;
    font-size: 26rpx;
  }
}